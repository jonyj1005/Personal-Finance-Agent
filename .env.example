# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production  (Plaid retired the separate "development" env)
PLAID_ENV=sandbox

# Encrypts Plaid access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./finance.db

# Required by Plaid for OAuth institutions (Fidelity, Vanguard, many banks) in production.
# Must be registered in the Plaid dashboard. Leave blank in sandbox.
PLAID_REDIRECT_URI=
